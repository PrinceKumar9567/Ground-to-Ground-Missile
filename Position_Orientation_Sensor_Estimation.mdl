__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_167.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="167">
  <P Name="name">Sensor_Measurments/MATLAB Function1</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">167</P>
  <P Name="ssIdHighWaterMark">6</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">18</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">167</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function Q_Dot = fcn(Gyro,Euler)

phi   = Euler(1);
theta = Euler(2);
shi   = Euler(3);

Transformation = [1 sin(phi)*tan(theta) cos(phi)*tan(theta);
                  0         cos(phi)         -1*sin(phi);
                  0 sin(phi)/cos(theta) cos(phi)/cos(theta)];

EulRate = Transformation*Gyro&apos;;

%%In world frame 
wx = EulRate(1);
wy = EulRate(2);
wz = EulRate(3);

%Constructing Omega Matrix for Q_DOT Computation - Q_Dot = 0.5*Omega*Q
Omega = [ 0   -wx  -wy  -wz;
          wx   0    wz  -wy;
          wy  -wz   0    wx;
          wz   wy  -wx   0 ];
cphi = cos(phi/2);   sphi = sin(phi/2);
cth  = cos(theta/2); sth  = sin(theta/2);
cshi = cos(shi/2);   sshi = sin(shi/2);

q1 = cphi*cth*cshi + sphi*sth*sshi;   % q0 (scalar)
q2 = sphi*cth*cshi - cphi*sth*sshi;   % q1
q3 = cphi*sth*cshi + sphi*cth*sshi;   % q2
q4 = cphi*cth*sshi - sphi*sth*cshi;   % q3

q = [q1; q2; q3; q4];
q = q / norm(q);   % enforce unit norm

Q_Dot = 0.5*Omega*q;
</P>
      </eml>
    </state>
    <data SSID="4" name="Gyro">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="Q_Dot">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="6" name="Euler">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
